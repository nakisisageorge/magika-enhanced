# magika-enhanced Environment Configuration
# Copy this file to .env and customize as needed

# Magika Model Configuration
# MAGIKA_MODEL_DIR=/path/to/custom/model  # Optional: override default model location

# Prediction Mode
# Options: best_guess, medium_confidence, high_confidence
MAGIKA_PREDICTION_MODE=high_confidence

# Cache Settings
MAGIKA_CACHE_SIZE=1024  # Number of cached predictions (0 to disable)

# Async Settings
MAGIKA_MAX_CONCURRENT=50  # Maximum concurrent operations for batch processing

# Custom Rules
# MAGIKA_RULES_FILE=/path/to/rules.yaml  # Optional: custom rules file
# MAGIKA_RULES_FILES=/path/to/rules1.yaml,/path/to/rules2.yaml  # Optional: additional rules files

# MCP Server
MCP_TRANSPORT=stdio  # Options: stdio, http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
# LOG_FILE=/path/to/logfile.log  # Optional: log to file

# Benchmark Settings
BENCHMARK_ITERATIONS=5
BENCHMARK_WARMUP_RUNS=2
BENCHMARK_MAX_FILES=1000
BENCHMARK_MEASURE_MEMORY=true
BENCHMARK_MEASURE_CPU=true

# Security
MAX_FILE_SIZE_MB=100  # Maximum file size to process
ALLOWED_PATHS=/home,/tmp,/data  # Comma-separated allowed base paths

# Development
# DEV_MODE=false  # Set to true for development features